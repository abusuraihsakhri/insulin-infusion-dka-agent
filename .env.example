# Insulin Infusion DKA Agent - Environment Configuration
# Copy this file to .env and update values for your deployment

# HMAC-SHA256 Audit Trail Secret Key
# IMPORTANT: Change this in production! Use a cryptographically secure random value.
AUDIT_SECRET_KEY=change-me-to-a-secure-random-key

# LLM Provider (mock, ollama, claude, openai)
MODEL_PROVIDER=mock

# API Server Configuration
API_HOST=127.0.0.1
API_PORT=8000
