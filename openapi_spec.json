{
  "openapi": "3.1.0",
  "info": {
    "title": "Insulin Infusion DKA Agent API",
    "description": "Legacy generic task-audit demo plus research-only adult DKA lab calculations. Not a clinical treatment system.",
    "version": "3.0.0",
    "contact": {
      "name": "Dr. Abu Suraih Sakhri",
      "url": "https://github.com/abusuraihsakhri"
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health and metadata check",
        "responses": {
          "200": {
            "description": "System optimal"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Prometheus operational metrics",
        "responses": {
          "200": {
            "description": "Operational counters as JSON, not Prometheus text"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Dispatch task payload across specialized workers",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number"
                  },
                  "status_descriptor": {
                    "type": "string"
                  },
                  "is_critical_flag": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Consensus dossier with HMAC signature"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Return an offline, deterministic mock response (no language-model inference)",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Supervisory response"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Read in-memory audit chain (requires configured X-Audit-Token)",
        "responses": {
          "200": {
            "description": "Cryptographic audit trail"
          },
          "403": {
            "description": "Disabled or unauthorized"
          }
        }
      }
    },
    "/api/dka-monitor": {
      "post": {
        "summary": "Research-only adult DKA laboratory interpretation; no medication dosing",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "glucose_mg_dl",
                  "potassium_mmol_l",
                  "beta_hydroxybutyrate_mmol_l",
                  "venous_ph",
                  "bicarbonate_mmol_l"
                ],
                "properties": {
                  "glucose_mg_dl": {
                    "type": "number"
                  },
                  "potassium_mmol_l": {
                    "type": "number"
                  },
                  "beta_hydroxybutyrate_mmol_l": {
                    "type": "number"
                  },
                  "venous_ph": {
                    "type": "number"
                  },
                  "bicarbonate_mmol_l": {
                    "type": "number"
                  },
                  "previous_glucose_mg_dl": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "hours_between_measurements": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Descriptive laboratory flags and glucose trend"
          },
          "422": {
            "description": "Invalid measurements"
          }
        }
      }
    }
  }
}
